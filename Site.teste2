<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Acerte o Número</title>

<style>
body{
    font-family: Arial, sans-serif;
    text-align: center;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    color: white;
    padding-top: 50px;
}

.container{
    background: rgba(255,255,255,0.15);
    width: 350px;
    margin: auto;
    padding: 20px;
    border-radius: 15px;
}

input{
    padding: 10px;
    font-size: 18px;
    width: 80px;
    text-align: center;
}

button{
    padding: 10px 20px;
    font-size: 18px;
    margin-top: 10px;
    cursor: pointer;
}

#resultado{
    margin-top: 20px;
    font-size: 22px;
    font-weight: bold;
}
</style>
</head>
<body>

<div class="container">
    <h1>🎮 Acerte o Número</h1>
    <p>Tente adivinhar um número de 1 a 10!</p>

    <input type="number" id="palpite" min="1" max="10">
    <br><br>

    <button onclick="jogar()">Tentar</button>

    <div id="resultado"></div>
</div>

<script>
let numeroSecreto = Math.floor(Math.random() * 10) + 1;

function jogar() {
    let palpite = Number(document.getElementById("palpite").value);
    let resultado = document.getElementById("resultado");

    if (palpite === numeroSecreto) {
        resultado.innerHTML = "🎉 Parabéns! Você acertou!";
        numeroSecreto = Math.floor(Math.random() * 10) + 1;
    } else {
        resultado.innerHTML = "❌ Errou! Tente novamente.";
    }
}
</script>

</body>
</html>
